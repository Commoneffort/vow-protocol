# Rust / Anchor build artifacts
target/*
.anchor/

# Keep generated IDL and TypeScript types for integrators
!target/idl
!target/idl/**
!target/types
!target/types/**

# Node
node_modules/
sdk/node_modules/

# Frontend build output and leftovers (source is tracked)
frontend/node_modules/
frontend/dist/
frontend/frontend/
frontend/.vercel/
frontend/src/sdk/idnft*

# Vercel deployment metadata
.vercel/
vercel.json
!deploy/vercel-redirect/vercel.json
.vercelignore

# Test validator state — contains ephemeral keypairs, ledger data
test-ledger/

# Any stray keypair files that land in the repo root or scripts
*.json.bak
id.json
*-keypair.json
*-key.json

# Misc
.DS_Store
*.log
yarn-error.log

# Secrets: never commit keys, tokens, or local agent settings
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*keypair*.json
wallet.json
.claude/


# Test-only CPI fixture build output
tests/fixtures/*/target/
